  "main": "src/server.js",
  "scripts": {
    "test": "jest --runInBand",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint",
    "migrate:up": "node-pg-migrate up --envPath .env -m migrations",
    "migrate:down": "node-pg-migrate down --envPath .env -m migrations",
    "migrate:test": "node -e \"process.env.DATABASE_URL=require('dotenv').config().parsed.TEST_DATABASE_URL; require('child_process').execSync('npx node-pg-migrate up -m migrations', {stdio:'inherit'})\""
  },
