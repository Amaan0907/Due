NODE_ENV=development
PORT=4000
# Local: postgres://postgres:postgres@localhost:5432/due
# Neon/Render: add ?sslmode=require to the end of the URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/due
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/due_test
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
